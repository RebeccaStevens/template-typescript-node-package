{
  "$schema": "node_modules/knip/schema-jsonc.json",
  "project": ["src/**/*.ts!"],
  "ignoreDependencies": [
    "@eslint/compat",
    "semantic-release",
    "semantic-release-publint",
  ],
  "ignoreBinaries": [
    "semantic-release",
  ],
  "exclude": ["exports", "nsExports", "types", "nsTypes"],
}
